# .env.example
# Add this file as .env and fill in your actual values

# Optional OpenAI API Key for testing real translation using LLM
OPENAI_API_KEY="your-openai-api-key"

# Translation Provider to use: "llm" or "mock"
# Use "mock" if you don't have an API key (tests will use mock by default)
TRANSLATION_PROVIDER="mock"

# API Settings
HOST="0.0.0.0"
PORT="8000"
DEBUG="True"
